# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Neon Postgres. The POOLED connection string works everywhere, including the
# Serializable credit transactions and the ledger tests — verified against
# both endpoints. (An earlier note here claimed the pooler could not hold
# those transactions; that was wrong. The failures it was blamed for were
# Prisma's 5s default transaction timeout expiring against a remote database,
# and they reproduced identically on the direct endpoint. See TX_OPTS in
# src/lib/credits.ts.)
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/cutline?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Sign-in providers (at least one)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# ...or email links
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Cutline Studio <noreply@example.com>"

# Stripe. The webhook secret comes from `stripe listen` locally, or from the
# endpoint's signing secret in the dashboard once deployed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
