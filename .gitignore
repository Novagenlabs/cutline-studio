# Secrets — never commit. Neon URLs and Stripe keys live here.
.env
.env.*
!.env.example

# scratch test output
*.txt
!requirements*.txt

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Scratch dir for `npx vgpu examples pull` — the example is vendored into
# src/vendor/flare instead, so a re-pull here is only ever for diffing.
/nextjs-flare
