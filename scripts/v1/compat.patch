+/**
+ * [v1 compatibility] The server only accepts `[\w. -]` in the download name,
+ * and this version sent the file's name through untouched — so "logo (1).png"
+ * failed the paid export with a bare 400. Sanitised here exactly as the
+ * current client does, so the frozen v1 keeps exporting.
+ */
+export function safeFilenameBase(base: string): string {
+  const cleaned = base
+    .normalize('NFKD')
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/[^\w. -]+/g, '-')
+    .replace(/[-\s]{2,}/g, '-')
+    .replace(/^[-.\s]+|[-.\s]+$/g, '')
+    .slice(0, 100);
+  return `${cleaned || 'cutline'}-cut`;
+}
 
 export interface ExportContext {
   result: CutlineResult;
